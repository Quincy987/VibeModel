<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VibeModel.Loader - the stable add-in Revit loads (plan 19).
    VibeModel.addin names this assembly. It finds the real add-in (VibeModel.dll) - next to
    itself (a developer build), else the version %LOCALAPPDATA%\VibeModel\versions\current.txt
    names, else the newest version folder - loads it and hands it OnStartup/OnShutdown.
    An in-app update only adds a version folder: this file is never replaced by an update, so
    Revit's add-in security prompt ("Always Load") is not asked again.
    Its version (1.0.0) is independent of VibeModel's; bump it only when the loader changes.
    References RevitAPI + RevitAPIUI only: no WPF, no Markdig, no VibeModel.dll.
  -->

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)'==''">2023</RevitVersion>

    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>

    <AssemblyName>VibeModel.Loader</AssemblyName>
    <RootNamespace>VibeModel.Loader</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>VibeModel</Authors>
    <Description>Loads the installed VibeModel version into Revit</Description>

    <OutputPath>bin\$(Configuration)\Revit$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="'$(RevitVersion)'=='2022'">
    <PackageReference Include="Autodesk.Revit.SDK" Version="2022.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RevitVersion)'=='2023'">
    <PackageReference Include="Autodesk.Revit.SDK" Version="2023.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RevitVersion)'=='2024'">
    <PackageReference Include="Autodesk.Revit.SDK" Version="2024.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RevitVersion)'=='2025'">
    <PackageReference Include="Autodesk.Revit.SDK" Version="2025.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
