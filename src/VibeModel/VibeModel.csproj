<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VIBEMODEL - AI Integration for Revit
    =====================================
    Embedded HTTP server for AI-driven Revit interaction.

    Build commands:
      dotnet build -c Release -p:RevitVersion=2023
      dotnet build -c Release -p:RevitVersion=2024
  -->

  <PropertyGroup>
    <!-- Default to Revit 2023 if not specified -->
    <RevitVersion Condition="'$(RevitVersion)'==''">2023</RevitVersion>

    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>

    <!-- Assembly configuration -->
    <AssemblyName>VibeModel</AssemblyName>
    <RootNamespace>VibeModel</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>VibeModel</Authors>
    <Description>AI integration for Autodesk Revit - talk to your model in natural language</Description>

    <!-- Output configuration -->
    <OutputPath>bin\$(Configuration)\Revit$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Disable features not needed/supported -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- Revit Addins deployment path -->
    <RevitAddinFolder>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinFolder>
  </PropertyGroup>

  <!-- Revit SDK references (version-specific) -->
  <ItemGroup Condition="'$(RevitVersion)'=='2022'">
    <PackageReference Include="Autodesk.Revit.SDK" Version="2022.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RevitVersion)'=='2023'">
    <PackageReference Include="Autodesk.Revit.SDK" Version="2023.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RevitVersion)'=='2024'">
    <PackageReference Include="Autodesk.Revit.SDK" Version="2024.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RevitVersion)'=='2025'">
    <PackageReference Include="Autodesk.Revit.SDK" Version="2025.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- WPF references for Clipboard -->
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!-- Post-build deployment -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="'$(Configuration)'=='Release' Or '$(Configuration)'=='Debug'">
    <Message Importance="high" Text="Deploying VibeModel to Revit $(RevitVersion) Addins folder..." />

    <!-- Create target folder if it doesn't exist -->
    <MakeDir Directories="$(RevitAddinFolder)" Condition="!Exists('$(RevitAddinFolder)')" />

    <!-- Copy DLL -->
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(RevitAddinFolder)"
      SkipUnchangedFiles="true" />

    <!-- Copy .addin manifest (from solution root) -->
    <Copy
      SourceFiles="$(ProjectDir)..\..\VibeModel.addin"
      DestinationFolder="$(RevitAddinFolder)"
      SkipUnchangedFiles="true" />

    <Message Importance="high" Text="VibeModel deployment complete: $(RevitAddinFolder)" />
  </Target>

</Project>
