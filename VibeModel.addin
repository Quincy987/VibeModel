<?xml version="1.0" encoding="utf-8"?>
<!--
  VibeModel - AI Integration for Autodesk Revit

  This add-in provides an embedded HTTP server that allows AI assistants
  (Claude, etc.) to inspect and modify Revit models via simple curl commands.

  Deployment (install.cmd does this):
    This file and VibeModel.Loader.dll go to
      %APPDATA%\Autodesk\Revit\Addins\{version}\      ({version} = 2022, 2023 or 2024)
    The add-in itself (VibeModel.dll, Markdig.dll, VibeModel.PdfText\) goes to
      %LOCALAPPDATA%\VibeModel\versions\<VibeModel version>\
    and versions\current.txt names the version to start. The loader starts that version, or a
    VibeModel.dll right next to it (a developer build). Updating = a new version folder; the
    loader - the file Revit asks about ("Always Load") - stays the same.
-->
<RevitAddIns>
  <AddIn Type="Application">
    <!-- Unique GUID for this add-in (unchanged since the first release: Revit sees one add-in) -->
    <ClientId>B2C3D4E5-F6A7-8901-BCDE-F12345678901</ClientId>

    <!-- Display name in Revit's Add-In Manager -->
    <Name>VibeModel - AI Integration</Name>

    <!-- The loader; it starts the installed VibeModel.dll -->
    <Assembly>VibeModel.Loader.dll</Assembly>

    <!-- Full class name of the loader's IExternalApplication -->
    <FullClassName>VibeModel.Loader.LoaderApp</FullClassName>

    <!-- Vendor identification -->
    <VendorId>VIBEMODEL</VendorId>
    <VendorDescription>VibeModel - AI-powered Revit modelling</VendorDescription>
  </AddIn>
</RevitAddIns>
